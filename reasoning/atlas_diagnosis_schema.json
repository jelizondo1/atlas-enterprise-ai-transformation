{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Current-State Diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_name",
    "executive_summary",
    "process_steps",
    "quantitative_baseline",
    "diagnostic_findings",
    "source_conflicts",
    "diagnostic_hypotheses",
    "limitations"
  ],
  "properties": {
    "case_name": {
      "type": "string"
    },
    "executive_summary": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "evidence_type",
          "confidence",
          "evidence_refs"
        ],
        "properties": {
          "statement": {
            "type": "string"
          },
          "evidence_type": {
            "enum": [
              "DIRECT",
              "DERIVED",
              "INFERRED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "process_steps": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "process_step",
          "actor",
          "trigger",
          "inputs",
          "systems_used",
          "activity",
          "decision_required",
          "outputs",
          "handoffs",
          "policy_constraints",
          "approval_required",
          "failure_modes",
          "evidence_refs"
        ],
        "properties": {
          "step_id": {
            "type": "string"
          },
          "process_step": {
            "type": "string"
          },
          "actor": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "trigger": {
            "type": "string"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "systems_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "activity": {
            "type": "string"
          },
          "decision_required": {
            "type": "string"
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "handoffs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "policy_constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approval_required": {
            "type": "string"
          },
          "failure_modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "quantitative_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cases_analyzed",
        "avg_handling_minutes",
        "avg_resolution_days",
        "sla_attainment",
        "reopen_rate",
        "missing_evidence_rate",
        "avg_systems_accessed"
      ],
      "properties": {
        "cases_analyzed": {
          "type": "integer"
        },
        "avg_handling_minutes": {
          "type": "number"
        },
        "avg_resolution_days": {
          "type": "number"
        },
        "sla_attainment": {
          "type": "number"
        },
        "reopen_rate": {
          "type": "number"
        },
        "missing_evidence_rate": {
          "type": "number"
        },
        "avg_systems_accessed": {
          "type": "number"
        }
      }
    },
    "diagnostic_findings": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "finding",
          "category",
          "evidence_type",
          "confidence",
          "support",
          "operational_impact",
          "evidence_refs"
        ],
        "properties": {
          "finding_id": {
            "type": "string"
          },
          "finding": {
            "type": "string"
          },
          "category": {
            "enum": [
              "PROCESS",
              "INFORMATION",
              "DECISION",
              "SYSTEM",
              "POLICY",
              "PEOPLE_OPERATING_MODEL",
              "CONTROL"
            ]
          },
          "evidence_type": {
            "enum": [
              "DIRECT",
              "DERIVED",
              "INFERRED"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "support": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operational_impact": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "source_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "conflict_id",
          "description",
          "sources",
          "why_unresolved",
          "required_authority"
        ],
        "properties": {
          "conflict_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "why_unresolved": {
            "type": "string"
          },
          "required_authority": {
            "type": "string"
          }
        }
      }
    },
    "diagnostic_hypotheses": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hypothesis_id",
          "hypothesis",
          "basis",
          "confidence",
          "how_to_test"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string"
          },
          "hypothesis": {
            "type": "string"
          },
          "basis": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "how_to_test": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}